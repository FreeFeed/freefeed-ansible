user nginx;
worker_processes auto;

error_log  /var/log/nginx/error.log warn;
pid        /var/run/nginx.pid;

events {
  worker_connections  1024;
}


http {
  include       /etc/nginx/mime.types;
  default_type  application/octet-stream;

  log_format  main  '[$time_local] $remote_addr - $remote_user "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for" '
                    '$request_time $upstream_response_time $pipe';

  log_format  proxy_log '[$time_local] $remote_addr - $remote_user "$host$request_uri" '
                      '$status $body_bytes_sent "$http_referer" '
                      '"$http_user_agent" "$http_x_forwarded_for"'
                      ' Proxy: "$proxy_host" "$upstream_addr" $upstream_response_time';

  access_log  /var/log/nginx/access.log main;

  sendfile on;
  tcp_nopush on;
  tcp_nodelay on;
  keepalive_timeout 65;
  types_hash_max_size 2048;
  client_max_body_size {{ nginx_client_max_body_size }};

  gzip on;
  gzip_vary on;
  gzip_proxied any;
  gzip_comp_level 6;
  gzip_buffers 16 8k;
  gzip_http_version 1.1;
  gzip_min_length 1000;
  gzip_types text/plain text/css application/json application/x-javascript text/xml application/xml application/xml+rss text/javascript application/javascript;
  charset_types text/plain text/css application/javascript;
  charset utf-8;

  include ssl.conf;

  geo $dollar {
    default "$";
  }

  {% if use_imgproxy %}
  # imgproxy commands
  ## ?format=jpeg|webp|avif
  map $arg_format $imgp_format {
      default "";
      jpeg    "/f:jpg";
      webp    "/f:webp";
      avif    "/f:avif";
  }

  ## ?width=123&height=321
  map "$arg_width $arg_height" $imgp_resize {
      default "";
      "~^[1-9]\d{0,3} [1-9]\d{0,3}$" "/rs:fill:$arg_width:$arg_height";
  }

  map "" $imgp_cmd {
      default "$imgp_resize$imgp_format";
  }
  # End of imgproxy commands
  {% endif %}

  server {
    listen 80 default_server;
    listen [::]:80 default_server;
    root /var/empty;
    return 301 https://$host$request_uri;
  }

  include /etc/nginx/conf.d/*.conf;
}
